#!/usr/bin/env bash
# Power menu via Walker (Super+Escape)
choice=$(printf '%s\n' \
  "󰌾  Lock" \
  "󰤄  Suspend" \
  "󰍃  Log out" \
  "󰜉  Restart" \
  "󰐥  Shut down" |
  walker --dmenu --placeholder "System" --width 320 --height 300)

# Let the menu finish closing first, otherwise the lock screen's screenshot
# still contains it and it fades out visibly after unlocking
wait_closed() {
  for _ in {1..20}; do
    hyprctl layers -j | grep -q '"namespace": "walker' || break
    sleep 0.05
  done
  sleep 0.2
}

case "$choice" in
  *Lock)       wait_closed; loginctl lock-session ;;
  *Suspend)    wait_closed; systemctl suspend ;;
  *"Log out")  uwsm stop ;;
  *Restart)    systemctl reboot ;;
  *"Shut down") systemctl poweroff ;;
esac
