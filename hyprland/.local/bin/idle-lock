#!/usr/bin/env bash
# Idle lock in two steps (driven by hypridle):
#   idle-lock off   screenshot every monitor, then turn the screens off
#   idle-lock on    activity before the lock: screens back on
#   idle-lock lock  start hyprlock with those screenshots as background
# hyprlock cannot capture its own screenshot while the screens are off,
# so the lock screen reuses the ones taken before they went dark.

dir="${XDG_RUNTIME_DIR:-/tmp}/idle-lock"
conf="$HOME/.config/hypr/hyprlock.conf"

case "$1" in
  off)
    mkdir -p "$dir"
    rm -f "$dir"/*.png
    for mon in $(hyprctl monitors -j | jq -r '.[].name'); do
      timeout 2 grim -o "$mon" "$dir/$mon.png"
    done
    # Swallow the key that wakes the screen (submap "idle" in hyprland.lua)
    hyprctl dispatch 'hl.dsp.submap("idle")' >/dev/null
    hyprctl dispatch 'hl.dsp.dpms({action = "off"})' >/dev/null
    ;;
  on)
    hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null
    hyprctl dispatch 'hl.dsp.dpms({action = "on"})' >/dev/null
    ;;
  lock)
    # Leave the "idle" submap, otherwise the keyboard stays captured after unlocking
    hyprctl dispatch 'hl.dsp.submap("reset")' >/dev/null
    pidof hyprlock >/dev/null && exit 0
    # Same config, but the background block points at the saved screenshots
    gen="$dir/hyprlock.conf"
    {
      # Plain fallback first, the screenshots are drawn on top of it
      printf 'background {\n    monitor =\n    color = rgb(1e1e2e)\n}\n'
      for img in "$dir"/*.png; do
        [ -e "$img" ] || continue
        cat <<EOF
background {
    monitor = $(basename "$img" .png)
    path = $img
    blur_passes = 3
    color = rgb(1e1e2e)
}
EOF
      done
      awk '/^background \{/ { skip = 1 } !skip { print } skip && /^\}/ { skip = 0 }' "$conf"
    } > "$gen"
    hyprlock -c "$gen" --no-fade-in
    ;;
  *) echo "usage: idle-lock off|on|lock" >&2; exit 1 ;;
esac
