#!/usr/bin/env bash
# Searchable list of all Hyprland keybindings that have a description (Super+K)
hyprctl binds -j | jq -r '
  def mods: [ (if ((.modmask/64|floor)%2)==1 then "SUPER" else empty end),
              (if ((.modmask/4 |floor)%2)==1 then "CTRL"  else empty end),
              (if ((.modmask/8 |floor)%2)==1 then "ALT"   else empty end),
              (if ( .modmask      %2)==1     then "SHIFT" else empty end) ];
  def key: .key
    | sub("^RETURN$";"Enter") | sub("^SPACE$";"Space") | sub("^ESCAPE$";"Esc")
    | sub("^mouse:272$";"Left click") | sub("^mouse:273$";"Right click")
    | sub("^mouse_down$";"Scroll down") | sub("^mouse_up$";"Scroll up")
    | sub("^XF86";"");
  .[] | select((.description // "") != "")
      | ((mods + [key]) | join(" + ")) as $combo
      | "\($combo)\t\(.description)"' |
  awk -F'\t' '{ printf "%-28s %s\n", $1, $2 }' |
  walker --dmenu --hideqa --theme catppuccin-mono --placeholder "Keybindings" --width 760 --height 600 >/dev/null
